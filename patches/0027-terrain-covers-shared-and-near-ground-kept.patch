+                                                    const std::optional<uint8_t>& overscaledZ) {
+    const Key key{z,
+                  zoomRange.min,
+                  zoomRange.max,
+                  overscaledZ ? int16_t{*overscaledZ} : int16_t{-1},
+                  state.roundZoom,
+                  state.nearDetail};
+    auto found = covers.find(key);
+    if (found == covers.end()) {
+        found = covers.emplace(key, tileCover(state, z, zoomRange, overscaledZ)).first;
+    }
+    return found->second;
+}
