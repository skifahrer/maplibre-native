+    const OverscaledTileID atOrigin{6, 0, CanonicalTileID(6, 0, 0)};
+    EXPECT_NE(std::find(tiles.begin(), tiles.end(), atOrigin), tiles.end());
+    for (const auto& id : tiles) {
+        const double size = 1.0 / (1 << id.canonical.z);
