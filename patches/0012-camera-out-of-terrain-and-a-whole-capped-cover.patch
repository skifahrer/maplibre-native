+        const auto n = static_cast<int64_t>(numTiles);
+        if (cy >= 0 && cy < n) {
+            const auto wrap = static_cast<int16_t>(cx >= 0 ? cx / n : (cx - n + 1) / n);
+            const auto x = static_cast<uint32_t>(cx - wrap * n);
+            const auto y = static_cast<uint32_t>(cy);
