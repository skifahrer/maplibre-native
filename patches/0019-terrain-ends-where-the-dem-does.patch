+bool RenderTileSource::tileHasNoData(const UnwrappedTileID& id) const {
+    for (const auto& [tileID, tile] : tilePyramid.getTiles()) {
+        if (tileID.toUnwrapped() == id) {
+            return tile->isComplete() && !tile->isRenderable();
+        }
+    }
+    return false;
+}
+
