+    }
+    if (!sightAnchorPending || !centerClampedToGround || transform.inTransition() || !sightGroundOnTheLine()) {
+        return;
+    }
+    sightAnchorPending = false;
+    if (setCenterAltitudeKeepingView(elevationMeters)) {
+        cameraMutated = true;
         onUpdate();
     }
 }
 
