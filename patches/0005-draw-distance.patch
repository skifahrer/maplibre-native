+
+void TransformState::setDrawDistance(double metres) {
+    const double clamped = std::isfinite(metres) ? std::max(0.0, metres) : 0.0;
+    if (drawDistance != clamped) {
+        drawDistance = clamped;
+        requestMatricesUpdate = true;
+    }
